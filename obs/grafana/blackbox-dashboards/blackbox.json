{
  "id": null,
  "uid": "blackbox-probes",
  "title": "Blackbox Exporter - HTTP Probes",
  "tags": ["blackbox", "availability"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Probe Status",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "host-prometheus" },
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "refId": "A", "expr": "probe_success{job=\"blackbox\"}", "legendFormat": "{{endpoint}}", "instant": true }],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "noValue": "NO DATA",
          "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 2,
      "title": "HTTP Status Code",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "host-prometheus" },
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "refId": "A", "expr": "probe_http_status_code{job=\"blackbox\"}", "legendFormat": "{{endpoint}}", "instant": true }],
      "fieldConfig": { "defaults": { "decimals": 0, "noValue": "NO DATA" }, "overrides": [] },
      "options": { "colorMode": "none", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 3,
      "title": "Response Time",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "host-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [{ "refId": "A", "expr": "probe_duration_seconds{job=\"blackbox\"}", "legendFormat": "{{endpoint}}", "range": true }],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 4,
      "title": "Availability In Selected Period",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "host-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [{ "refId": "A", "expr": "100 * avg_over_time(probe_success{job=\"blackbox\"}[$__range])", "legendFormat": "{{endpoint}}", "instant": true }],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100, "decimals": 2, "noValue": "NO DATA", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 95 }, { "color": "green", "value": 99.9 }] } },
        "overrides": []
      },
      "options": { "colorMode": "value", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 5,
      "title": "Probe Status History",
      "type": "state-timeline",
      "datasource": { "type": "prometheus", "uid": "host-prometheus" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 13 },
      "targets": [{ "refId": "A", "expr": "probe_success{job=\"blackbox\"}", "legendFormat": "{{endpoint}}", "range": true }],
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "mergeValues": true, "showValue": "auto", "rowHeight": 0.8 }
    },
    {
      "id": 6,
      "title": "Probe Scrape Health",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "host-prometheus" },
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 19 },
      "targets": [{ "refId": "A", "expr": "up{job=\"blackbox\"}", "legendFormat": "{{endpoint}}", "instant": true }],
      "fieldConfig": {
        "defaults": {
          "noValue": "NO DATA",
          "mappings": [{ "type": "value", "options": { "0": { "text": "SCRAPE FAILED", "color": "red" }, "1": { "text": "SCRAPE OK", "color": "green" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    }
  ]
}